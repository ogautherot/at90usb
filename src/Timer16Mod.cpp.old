#include "Timer16Mod.h"
#include "Rtc.h"

Timer16Mod timer16;

Timer16Mod::Timer16Mod()
{
    // Free running counter
    TCCR1A = 0;
    TCCR1B = (1 << CS10);
    TCCR1C = 0;
    TCNT1 = 0;
    TIMSK1 = 0;

    // RTC counter
    TCNT3 = 0;
    TIMSK3 = (1 << OCIE3A);
    OCR3A = 31249;
    TCCR3A = 0;            // No port activity, WGM3[1:0] = 0
    TCCR3B = (1 << WGM32); // WGM3[3:2] = 01
    TCCR3C = 0;

    TIFR1 = 0; // (1 << TOV1) || (1 << OCF1A)
    TIFR3 = (1 << OCF3A);
}

