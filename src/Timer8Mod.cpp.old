#include "Timer8Mod.h"
#include "EventQueue.h"

#include "GpioMod.h"
#include "KeysMod.h"

Timer8Mod timer02;

Timer8Mod::Timer8Mod()
{
    GTCCR = 0;

    // ADC
    // Mode CTC (WGM = 010)
    TCCR0A = 0x02; // WGM0 and WGM1
    TCCR0B = 0;    // Set to 0x02 to start counting
    TCNT0 = 0;
    OCR0A = 0;              // Steps of 0.5us
    OCR0B = 0;              // Unused
    TIMSK0 = (1 << OCIE0A); // OCIE0A

    // System tick (1ms)
    // Prescaler x64 (125kHz), Output Compare A = 125
    // Mode CTC (WGM = 010)
    TCCR2A = (1 << WGM21); // WGM=010 (CTC)
    TCCR2B = 0;            // Set to 0x04 to start counting
    TCNT2 = 0;
    OCR2A = 125;            // Steps of 0.5us
    OCR2B = 0;              // Unused
    TIMSK2 = (1 << OCIE2A); // None

    TIFR0 = 0; // (1 << TOV0) || (1 << OCF0A) || (1 << OCF0B)
    TIFR2 = 0; // (1 << TOV2) || (1 << OCF2A) || (1 << OCF2B)
}

// Timer8Mod::Timer8Mod(const Timer8Mod& orig) { }

// Timer8Mod::~Timer8Mod() { }

int8_t Timer8Mod::SetTimer(uint8_t t, uint8_t arg0)
{
    int8_t ret = -1;

    if (t < 128)
    {
        OCR2A = t << 1;
        TCCR2B = 0x02;
        EventArg0 = arg0;
        ret = 0;
    }
    return ret;
}

